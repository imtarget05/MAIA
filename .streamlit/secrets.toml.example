# =============================================================================
# ⚠️  TEMPLATE ONLY — NEVER PUT REAL VALUES IN THIS FILE
# =============================================================================
#
# This is a placeholder template.  Copy this file to `.streamlit/secrets.toml`
# template to `.streamlit/secrets.toml` and fill in the values for your
# environment.  Ensure `.streamlit/secrets.toml` is listed in `.gitignore`
# and NEVER committed to version control.
#
# The app reads `st.secrets` and promotes every string value into
# `os.environ` (see `app_streamlit.py`), so the keys below must match the
# environment variable names exactly.
# =============================================================================

# ---------------------------------------------------------------------------
# Core API endpoints
# ---------------------------------------------------------------------------
MAIA_API_URL = "<YOUR_ACA_API_URL>"
# Base URL of the MAIA FastAPI backend (Azure Container Apps; use
# http://localhost:8000 for local dev).
# Set sync: false in Streamlit Community Cloud settings — the user updates
# this after the API is deployed.

API_BASE_URL = "<YOUR_ACA_API_URL>"
# Explicit API base URL (mirrors MAIA_API_URL for clarity in production).

APP_BASE_URL = "<YOUR_ACA_UI_URL>"
# Public URL of the Streamlit UI.  Used for CORS configuration and links.

# ---------------------------------------------------------------------------
# Qdrant (vector store)
# ---------------------------------------------------------------------------
QDRANT_URL = "https://774ac119-c3e3-4cc6-a3b8-810e334342cc.eu-west-1-0.aws.cloud.qdrant.io"
# Qdrant Cloud cluster endpoint (include https:// and port if non-default).

QDRANT_API_KEY = "<QDRANT_CLOUD_API_KEY>"
# API key from the Qdrant Cloud dashboard → your cluster → API Keys.

# ---------------------------------------------------------------------------
# Cloudflare Workers AI (LLM + embedding)
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID = "<CLOUDFLARE_ACCOUNT_ID>"
# Cloudflare account ID — found in the Cloudflare dashboard URL or
# Overview → Account Home.

CLOUDFLARE_API_TOKEN = "<CLOUDFLARE_API_TOKEN>"
# Cloudflare API token with Workers AI permissions.  Create one at:
# https://dash.cloudflare.com/profile/api-tokens

CLOUDFLARE_MODEL = "@cf/meta/llama-3.1-8b-instruct"
# Model to use for Cloudflare Workers AI inference.

# ---------------------------------------------------------------------------
# Authentication / security
# ---------------------------------------------------------------------------
JWT_SECRET_KEY = "<REPLACE_WITH_SAME_KEY_AS_THE_API>"
# MUST match the value set on the API service exactly so JWTs issued by
# the API can be verified by the app and vice-versa.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANT: In production, use the SAME key as the backend API service.

ENVIRONMENT = "production"
# Deployment environment.  Accepted values: "production", "staging",
# "development".  Controls logging verbosity and mock-mode fallbacks.

CORS_ORIGINS = "<YOUR_ACA_UI_URL>"
# Comma-separated list of origins the API should accept CORS requests from.
# In production this is the deployed UI URL (Azure Container Apps).
# For local development use: "http://localhost:8501"

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
LLAMA_INDEX_DATA_PLANE = "true"
# Set to "true" to route retrieval through the LlamaIndex data plane
# (dense + BM25 RRF fusion) instead of the default HybridRetriever path.
# Requires `llama-index-core` to be installed.

# ---------------------------------------------------------------------------
# Storage / data paths (server-side, must be writable)
# ---------------------------------------------------------------------------
STORAGE_DIR = "/tmp/storage"
# Writable directory for runtime state (agent checkpoint DB, BM25 cache,
# eval artifacts, etc.).  Streamlit Community Cloud allows writing to /tmp.

DATA_DIR = "./data/samples"
# Path to sample/documentation corpus (loaded at startup).

ENTERPRISE_DATA_DIR = "./data/enterprise"
# Path to enterprise policy documents ingested into the knowledge base.

# ---------------------------------------------------------------------------
# First-run / bootstrap settings
# ---------------------------------------------------------------------------
BOOTSTRAP_FIRST_ADMIN = "true"
# Set to "true" to auto-create the first admin user on first boot if no
# users exist.  Set to "false" (or remove) after the initial admin is
# created to prevent re-creation on every restart.

DEFAULT_EMPLOYEE_ID = "emp_001"
# Employee ID used as the default actor for unauthenticated requests and
# demo/smoke-test flows.  Must correspond to a record in the employee
# directory / HR database.
