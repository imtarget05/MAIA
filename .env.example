# MAIA Environment Configuration
STORAGE_DIR=storage
DATA_DIR=data

# LLM Gateway / LM Studio configuration
# Options: cloudflare | local_openai | lmstudio | ollama | mock
#
# All chat traffic goes through the centralized llm-gateway (OpenAI-compatible
# proxy in front of the LAN LM Studio / Ollama host) so usage is attributable in
# its central telemetry (llm-gateway/logs/llm-telemetry.jsonl, "project":"MAIA").
# Every request carries the header `X-Project: MAIA`.
LLM_PROVIDER=lmstudio
# Resolution order: LLM_BASE_URL (explicit) -> LLM_GATEWAY_URL -> LLM_DIRECT_UPSTREAM_URL.
# The gateway is tried first; the direct LAN upstream is used only when nothing is
# listening on the gateway port, so a gateway outage degrades instead of failing.
LLM_BASE_URL=http://localhost:8787/v1
LLM_GATEWAY_URL=http://localhost:8787/v1
LLM_DIRECT_UPSTREAM_URL=http://192.168.1.8:1234/v1
LLM_CHAT_MODEL=qwen2.5-vl-3b-instruct
LLM_TIMEOUT_SEC=120
# Short connect budget so a down gateway is skipped in seconds, not LLM_TIMEOUT_SEC.
LLM_CONNECT_TIMEOUT_SEC=3
# Project id sent as X-Project; canonical ids are MAIA and ApexInspect-AI.
LLM_PROJECT=MAIA

# Embedding configuration
# MAIA_EMBED_FORCE_HASH=1 pins the deterministic hash embedder (CI / offline).
MAIA_EMBED_FORCE_HASH=0
# Embeddings do NOT default to the gateway: the live chain stays
# Cloudflare -> fastembed -> hash, which is what the Qdrant collection width
# (CLOUDFLARE_EMBED_DIM=1024) was built for. Set EMBEDDINGS_PROVIDER=local_openai
# to route embeddings through the gateway's /v1/embeddings instead, and set
# EMBEDDINGS_DIM to that model's vector width (otherwise embedding raises
# EmbeddingDimMismatch instead of writing wrong-width vectors).
# Accepted values: "" (auto, default) | local_openai | lmstudio | lms | ollama.
EMBEDDINGS_PROVIDER=
# Same resolution order as LLM_BASE_URL when EMBEDDINGS_PROVIDER is a gateway
# provider: explicit -> gateway -> direct LAN upstream fallback.
EMBEDDINGS_BASE_URL=http://localhost:8787/v1
EMBEDDINGS_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDINGS_API_KEY=
EMBEDDINGS_TIMEOUT_SEC=60
EMBEDDINGS_CONNECT_TIMEOUT_SEC=3
EMBEDDINGS_DIM=0

# Observability: OpenTelemetry OTLP exporter (opt-in, default OFF).
# Set both to ship maia.query + stage spans to a collector (Jaeger/Tempo).
# OTEL_ENABLED=0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SERVICE_NAME=maia

# Vector store backend (ADR-0005). Which implementation of the
# maia.retrieval_port protocols MAIA builds:
#   qdrant          — default. The only backend the eval baselines were
#                     measured on. QDRANT_* below configure it.
#   azure_ai_search — Azure AI Search, HNSW vector profile. Needs S1 or
#                     higher (the free tier has no vector search) and the
#                     AZURE_AI_SEARCH_* values below. Do NOT flip this in
#                     production before the eval-parity gate in
#                     docs/azure-integration.md has been run.
#   memory          — offline InMemoryVectorStore (tests, demos).
VECTOR_STORE_BACKEND=qdrant

# Azure hosting. Leave EVERY value below empty for a local run: an empty
# Azure configuration is indistinguishable from a developer machine, and
# maia.azure_identity then uses the ambient credential chain (`az login`).
#
# AZURE_TENANT_ID / AZURE_CLIENT_ID identify the USER-ASSIGNED managed
# identity. On Azure, AZURE_CLIENT_ID pins which identity is used — without
# it the system-assigned identity is picked, which is a different principal
# with different role assignments (a silent 403, not a useful error). Off
# Azure both are ignored so the ambient chain is what a developer gets.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Non-empty vault URI turns on Key Vault secret resolution in
# maia.azure_identity.resolve_kv_secret. When empty, that function reads the
# process environment instead — same call, same argument, both environments.
# Key Vault wins over the environment whenever this is set, so a rotated
# secret can never be shadowed by a stale container config value.
AZURE_KEY_VAULT_URI=
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_INDEX=maia_knowledge
# LOCAL DEV FALLBACK ONLY. The cloud path is managed identity, so this stays
# empty in Azure. It exists because a dev container has no identity to
# assume. Never put a real key in this file.
AZURE_AI_SEARCH_API_KEY=
