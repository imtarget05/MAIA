# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=maia_knowledge
# Required for Qdrant Cloud (https://cloud.qdrant.io) - leave empty for local Docker
QDRANT_API_KEY=

# --- Embeddings (HuggingFace via FastEmbed) ---
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384

# --- Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# --- Retrieval ---
TOP_K_DENSE=10
TOP_K_BM25=10
TOP_K_FUSED=8
TOP_K_FINAL=3
SIMILARITY_THRESHOLD=0.3
RRF_K=60

# --- LLM: Cloudflare Workers AI ---
# Docs: https://developers.cloudflare.com/workers-ai/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
# If empty creds -> MOCK mode (templated answer from context, for offline demo/eval)

# --- Storage ---
STORAGE_DIR=./storage
DATA_DIR=./data/samples

# --- URL sources (notebook-style "paste a link", per-session scope) ---
URL_FETCH_TIMEOUT=10
URL_MAX_BYTES=2000000
URL_MAX_LINKS_PER_SESSION=20

# --- Kafka streaming ingestion (PROJECT 2) ---
# STREAM_TRANSPORT: inmemory (offline tests/benchmarks, default) | kafka (real broker)
STREAM_TRANSPORT=inmemory
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CHUNKS=topic.doc.chunks
KAFKA_TOPIC_DLQ=topic.doc.chunks.dlq
KAFKA_TOPIC_FAILED=topic.doc.embedding.failed
KAFKA_NUM_PARTITIONS=4
KAFKA_CONSUMER_GROUP=embedding-workers
# Partitioning mode: ordered (key=document_id, per-doc order) | max-throughput (key=hash(doc+chunk))
KAFKA_PARTITIONING=ordered
KAFKA_WORKERS=2
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_BACKOFF_MS=250
KAFKA_SKIP_EMBEDDED=true

# --- Corrective RAG (CRAG): grade -> refine/rewrite -> optional web fallback.
# All OFF by default: zero behavior change unless explicitly enabled.
CRAG_ENABLED=false
CRAG_GRADE_USE_LLM=false
CRAG_GRADE_THRESHOLD=0.35
CRAG_MAX_CORRECTIONS=2
CRAG_WEB_SEARCH_ENABLED=false

# --- Long-term memory (SQLite, cross-session). OFF by default.
LTM_ENABLED=false
LTM_DB_PATH=./storage/ltm.db
LTM_RECALL_K=3

# --- Archived (see _archive/): TEAM_*, MCP_*, VOICE_*, FINETUNE_* removed.

# --- Authentication ---
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Streamlit frontend -> FastAPI base URL (login + /admin/* calls)
API_BASE_URL=http://localhost:8000

# --- Email / notifications (empty SMTP_HOST = queue to storage/outbox.json) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=MAIA <no-reply@company.com>
SMTP_USE_TLS=true
# Department inboxes: leave workflows -> HR, IT tickets/VPN -> IT.
HR_EMAIL=hr@company.com
IT_EMAIL=it-help@company.com
SECURITY_EMAIL=security@company.com
APP_BASE_URL=http://localhost:8501
PASSWORD_RESET_EXPIRE_MIN=30
# First-ever registered user becomes admin (local bootstrap).
BOOTSTRAP_FIRST_ADMIN=true

# --- Approval workflow store (shared SQLite file) ---
WORKFLOW_DB_PATH=./storage/workflow.db

# --- UI display (enterprise customization, no code change needed) ---
# Hide backend tech details (Qdrant badge, chunk_ids, debug) from end users.
UI_SHOW_TECH_BADGE=false
# Answer tone: concise (1 sentence + 3-5 bullets) | detailed | formal
ANSWER_STYLE=concise

# --- PII role-email allowlist (G-04-FU2) ---
# Internal role contacts are NOT redacted. Comma-separated; empty entries ignored.
ROLE_EMAIL_ALLOWLIST=support@company.com,help@company.com,it-help@company.com,hr@company.com,hr-escalation@company.com,security@company.com,benefits@company.com,eap@company.com,finance@company.com,onboarding@company.com
ROLE_EMAIL_ALLOW_PREFIXES=support,help,it-help,it-,hr,hr-,security,benefits,eap,onboarding,finance
ROLE_EMAIL_ALLOW_DOMAIN=company.com
